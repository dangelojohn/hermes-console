# hermes-backup — environment template
# Copy to backup/.env.backup on the QNAP and chmod 600. NEVER commit values.

# ---------------------------------------------------------------------------
# Forgejo target (qnap/hermes-console)
# ---------------------------------------------------------------------------
# Generate this token INSIDE the forgejo container, scoped tight:
#   docker exec -u git forgejo forgejo admin user generate-access-token \
#     --username john --scopes "write:repository" --token-name hermes-backup
# Output is shown once — paste it below.
FORGEJO_BASE=https://southbrookcabinetry.space/git/api/v1
FORGEJO_OWNER=qnap
FORGEJO_REPO=hermes-console
FORGEJO_TOKEN=REPLACE_ME

# ---------------------------------------------------------------------------
# GitHub target (dangelojohn/hermes-console)
# ---------------------------------------------------------------------------
# Fine-grained PAT recommended:
#   Repository: dangelojohn/hermes-console
#   Permissions: Contents=write, Releases=write, Metadata=read
# Generate at https://github.com/settings/tokens?type=beta
GITHUB_OWNER=dangelojohn
GITHUB_REPO=hermes-console
GITHUB_TOKEN=REPLACE_ME

# ---------------------------------------------------------------------------
# GPG recipient — email or fingerprint that matches recipient.asc
# ---------------------------------------------------------------------------
GPG_RECIPIENT=dangelo.john@gmail.com

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
RETENTION_DAYS=3
BACKUP_INCLUDE_ENV=false
ALSO_MIRROR_GIT=true
TZ=America/Toronto
STATUS_OUT=/output/last-run.json
