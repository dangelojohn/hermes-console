# Hermes Console — environment template
# Copy to .env on the QNAP and fill in real values
# All secrets stay on the QNAP. NEVER commit a populated .env.

# ============================================================================
# === LLM providers ===========================================================
# ============================================================================

# Primary provider for new chats + agent loops: openai | hermes_harness
# The "openai" provider is a generic OpenAI-compatible client — it works with
# real OpenAI, Google Gemini's OpenAI-compat endpoint, OpenRouter, vLLM, etc.
# Pick ONE of the variants below and uncomment its three OPENAI_* lines.
HERMES_PRIMARY_PROVIDER=openai

# --- Variant A (RECOMMENDED): Google Gemini, free tier, OpenAI-compatible ---
# Get the API key from https://aistudio.google.com/apikey (free, no card).
# As of 2026-06: gemini-2.0-flash is locked out (limit:0) — use 2.5-flash.
# New key format is AQ.Ab8…  (52–53 chars), older AIza… (39) also works.
OPENAI_API_KEY=REPLACE_ME_AQ.Ab8xxxxxxxx
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_DEFAULT_MODEL=gemini-2.5-flash

# --- Variant B: real OpenAI ---
# Get the API key from https://platform.openai.com/api-keys
# gpt-4o is balanced; gpt-4o-mini is cheap; o1-preview is for hard reasoning.
# OPENAI_API_KEY=REPLACE_ME_sk_proj_xxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_DEFAULT_MODEL=gpt-4o

# --- Variant C: Anthropic (Claude API, native /v1/messages — separate provider slot) ---
# Anthropic does NOT expose an OpenAI-compatible endpoint, so this is wired
# as its own provider via AnthropicLLMClient (not via the openai slot above).
# To use it: set HERMES_PRIMARY_PROVIDER=anthropic AND populate the keys below.
# Get the API key from https://console.anthropic.com/settings/keys (BILLABLE).
# Default model claude-opus-4-8 per claude-api skill guidance.
# ANTHROPIC_API_KEY=REPLACE_ME_sk_ant_api03_xxxxxxxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_DEFAULT_MODEL=claude-opus-4-8
# ANTHROPIC_DEFAULT_MAX_TOKENS=4096

# --- Hermes harness (self-hosted or remote OpenAI-compatible endpoint) ---
# Configured as Groq's OpenAI-compatible endpoint for a free second LLM
# that survives Gemini's 20 req/min cap. Free tier on llama-3.3-70b-versatile:
#   30 req/min, 6000 req/day, 12K input tokens/min, 100K input tokens/day.
# Sign up + grab a key at https://console.groq.com/keys (no credit card).
# Leave HERMES_HARNESS_API_KEY blank to keep this provider disabled.
HERMES_HARNESS_API_KEY=
HERMES_HARNESS_BASE_URL=https://api.groq.com/openai/v1
HERMES_HARNESS_DEFAULT_MODEL=llama-3.3-70b-versatile

# Alternative models you can swap in (same Groq endpoint):
#   llama-3.1-8b-instant         — much higher throughput, lower quality
#   gemma2-9b-it                 — Google's open Gemma 2 9B
#   mistral-saba-24b             — Mistral's Saba 24B reasoning
#   qwen-qwq-32b                 — Alibaba's QwQ reasoning model
#   deepseek-r1-distill-llama-70b — DeepSeek R1 distillation
#
# If you'd rather use a different provider than Groq, replace BASE_URL with:
#   OpenRouter (free models)  https://openrouter.ai/api/v1   model e.g. google/gemini-2.0-flash-exp:free
#   Together AI               https://api.together.xyz/v1    model e.g. meta-llama/Llama-3.3-70B-Instruct-Turbo-Free
#   Anthropic (paid)          https://api.anthropic.com/v1   model e.g. claude-sonnet-4-7
#   Self-hosted Ollama        http://your-ollama:11434/v1    model whatever you've pulled

# ============================================================================
# === Tenant bridges (outbound push of approved recommendations) =============
# ============================================================================

# Southbrook (Fabio inside southbrook_hermes Odoo addon)
# Used by api/tenant_bridges/southbrook_hermes.py
# Leave SOUTHBROOK_HERMES_ENABLED=false to skip this bridge entirely.
SOUTHBROOK_HERMES_ENABLED=true
SOUTHBROOK_HERMES_URL=http://southbrook-odoo:8069
SOUTHBROOK_HERMES_DB=southbrook
SOUTHBROOK_HERMES_USER=admin
SOUTHBROOK_HERMES_PASSWORD=REPLACE_ME

# ============================================================================
# === API itself ==============================================================
# ============================================================================

HERMES_API_PORT=8810
HERMES_API_LOG_LEVEL=info
HERMES_SQLITE_PATH=/data/hermes.sqlite

# ============================================================================
# === UI ======================================================================
# ============================================================================

HERMES_UI_PORT=8811
HERMES_PUBLIC_URL=https://hermes.odooiq.com

# Display in the UI header
HERMES_TENANT_LABEL=Hermes
HERMES_TENANT_ICON=🦅

# ============================================================================
# === Agent loops =============================================================
# ============================================================================

# Comma-separated list of loops to enable on startup
# Available: platform_health, daily_digest, none
# Set to "none" to disable all proactive agents (chat-only mode)
HERMES_AGENT_LOOPS=platform_health

# How often the platform_health loop runs (seconds)
HERMES_PLATFORM_HEALTH_INTERVAL=900
